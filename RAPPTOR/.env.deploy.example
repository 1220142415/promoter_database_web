# Copy this file to .env.deploy. The real file is ignored by Git.
# Keep provider-issued secrets out of Git, screenshots, chat, and shell history.

# Public URLs and provider project
RAPPTOR_PUBLIC_SITE_URL=https://rapptor.duolalab.qzz.io
RAPPTOR_WORKER_BASE_URL=https://rapptor.duolalab.qzz.io
RAPPTOR_PREDICTION_SERVICE_URL=https://4090server.duolalab.qzz.io
# email = Supabase login + per-user quota + notifications; ip = anonymous Turnstile + per-IP quota.
RAPPTOR_PREDICTION_ACCESS_MODE=ip
SUPABASE_PROJECT_REF=swicrzrhvbkocrssmqpv
SUPABASE_URL=https://swicrzrhvbkocrssmqpv.supabase.co

# Provider-issued secrets. A Supabase personal access token needs auth:write.
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_ANON_KEY=
SUPABASE_SMTP_PASSWORD=
RESEND_API_KEY=

# Shared mail settings. Change these when the sending/site domain changes.
EMAIL_FROM_NAME=RAPPTOR
EMAIL_FROM_ADDRESS=no-reply@auth.email.duolalab.qzz.io
EMAIL_SUBJECT=Your RAPPTOR verification code
SUPABASE_SMTP_HOST=smtp.resend.com
SUPABASE_SMTP_PORT=465
SUPABASE_SMTP_USER=resend
SUPABASE_OTP_EXPIRY_SECONDS=3600
SUPABASE_OTP_LENGTH=6

# Cloudflare Turnstile
NEXT_PUBLIC_RAPPTOR_TURNSTILE_SITE_KEY=
RAPPTOR_TURNSTILE_SECRET=

# Generate two independent random values. The service secret is copied to both
# Worker and Docker names by the deployment script.
RAPPTOR_PREDICTION_SERVICE_SECRET=
RAPPTOR_PREDICTION_IP_HASH_SECRET=

# Shared Worker/Docker prediction limits
RAPPTOR_PREDICTION_MODEL_VERSION=candidate-github-93cf
RAPPTOR_PREDICTION_MAX_BASES=6000000
RAPPTOR_PREDICTION_SHORT_SEQUENCE_MAX_BASES=10000
RAPPTOR_PREDICTION_GENOME_SCANS_PER_DAY=5
RAPPTOR_PREDICTION_TICKETS_PER_MINUTE=2
RAPPTOR_PREDICTION_BASES_PER_DAY=12000000
RAPPTOR_PREDICTION_TICKET_TTL_SECONDS=120

# Docker prediction service
RAPPTOR_MODEL_HOST_DIR=./model-assets/candidate-github-93cf
RAPPTOR_GPU_INDEX=0
RAPPTOR_API_PORT=8000
RAPPTOR_MAX_REQUEST_BYTES=12582912
RAPPTOR_MAX_QUEUE_LENGTH=100
RAPPTOR_MIN_SCAN_STRIDE=1
RAPPTOR_MAX_SCAN_STRIDE=1000
RAPPTOR_DEFAULT_SCAN_STRIDE=1
RAPPTOR_FILE_RETENTION_SECONDS=86400
