# Prediction remains disabled until every capacity limit and secret is set.
RAPPTOR_PREDICTION_ENABLED=off
RAPPTOR_PREDICTION_SERVICE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_RAPPTOR_TURNSTILE_SITE_KEY=
RAPPTOR_PREDICTION_MODEL_VERSION=candidate-github-93cf
RAPPTOR_PREDICTION_MAX_BASES=
RAPPTOR_PREDICTION_TICKETS_PER_MINUTE=
RAPPTOR_PREDICTION_BASES_PER_DAY=
# The service contract permits 60-120 seconds; choose explicitly for deployment.
RAPPTOR_PREDICTION_TICKET_TTL_SECONDS=
RAPPTOR_TURNSTILE_SECRET=
RAPPTOR_PREDICTION_SERVICE_SECRET=
RAPPTOR_PREDICTION_IP_HASH_SECRET=
# Docker service callback target; use the same service secret configured above.
# RAPPTOR_JOB_CALLBACK_URL=https://example/api/internal/prediction-jobs
