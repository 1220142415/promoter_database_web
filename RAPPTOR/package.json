{
    "name": "rapptor",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "postinstall": "patch-package --error-on-fail",
        "postbuild": "node scripts/cloudflare/prepare-standalone.mjs",
        "start": "node .next/standalone/server.js",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "check": "npm run lint && npm run typecheck && npm test",
        "verify": "npm run check && npm run build",
        "analytics:map": "node scripts/data/build-world-map.mjs",
        "prediction:test": "PYTHONPATH=services/prediction/src python -m pytest services/prediction/tests",
        "prediction:compose:validate": "docker-compose -f services/prediction/compose.yaml config",
        "data:build": "node scripts/data/build-gtdb-release.mjs",
        "data:cyanobacteria": "python scripts/data/build-cyanobacteria-release.py",
        "data:validate": "node scripts/data/validate-gtdb-release.mjs",
        "data:pack": "node scripts/data/build-packed-release.mjs",
        "data:pack:materialize": "node scripts/data/materialize-packed-shard.mjs",
        "data:pack:validate": "node scripts/data/validate-packed-release.mjs",
        "data:d1:legacy": "node scripts/database/build-legacy-d1-import.mjs",
        "data:d1:sample": "node scripts/database/build-d1-feature-sample.mjs",
        "data:d1:gtdb-metadata": "node scripts/database/build-gtdb-metadata-d1-import.mjs",
        "data:d1:experimental-hf": "node scripts/database/build-experimental-tss-hf-release.mjs",
        "hf:plan": "node scripts/huggingface/create-upload-plan.mjs",
        "hf:upload:browser": "node scripts/huggingface/upload-hf-open-browser.mjs",
        "hf:reclaim:pack": "node scripts/huggingface/reclaim-uploaded-pack.mjs",
        "hf:upload:packed:cli": "python scripts/huggingface/upload-hf-packed-release.py",
        "hf:verify:packed": "python scripts/huggingface/verify-hf-packed-release.py",
        "hf:prepare": "node scripts/huggingface/prepare-hf-pilot.mjs",
        "hf:upload": "python scripts/huggingface/upload-hf-pilot.py",
        "hf:verify": "node scripts/huggingface/verify-hf-pilot.mjs",
        "hf:upload:release": "python scripts/huggingface/upload-hf-release.py",
        "hf:verify:release": "python scripts/huggingface/verify-hf-release.py",
        "hf:verify:cyanobacteria": "python scripts/huggingface/verify-cyanobacteria-release.py",
        "hf:batch-plan": "node scripts/huggingface/build-hf-batch-asset-plan.mjs",
        "data:experimental:build": "node scripts/huggingface/build-experimental-tss-release.mjs",
        "data:experimental:validate": "node scripts/huggingface/validate-experimental-tss-release.mjs",
        "data:experimental:audit-predictions": "node scripts/huggingface/audit-experimental-prediction-coverage.mjs",
        "test": "vitest run",
        "test:data": "node scripts/data/validate-gtdb-release.mjs --quick",
        "test:scores": "python -m unittest discover -s tests/python -p test_*.py",
        "test:watch": "vitest",
        "test:unit": "vitest run tests/unit",
        "test:api": "vitest run tests/api",
        "test:components": "vitest run tests/components",
        "test:e2e": "playwright test",
        "build:cf": "npm run check && node scripts/cloudflare/check-cloudflare-env.mjs && node scripts/cloudflare/run-opennext-build.mjs",
        "preview:cf": "npm run build:cf && opennextjs-cloudflare preview",
        "deploy:cf": "npm run build:cf && opennextjs-cloudflare deploy",
        "cf:typegen": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --env-file config/cloudflare-typegen.env"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@gmod/indexedfasta": "4.0.9",
        "@gmod/tabix": "3.1.0",
        "@jbrowse/embedded-core": "3.7.0",
        "@jbrowse/plugin-bed": "3.7.0",
        "@jbrowse/plugin-svg": "3.7.0",
        "@jbrowse/product-core": "3.7.0",
        "@jbrowse/react-linear-genome-view": "3.1.0",
        "@mui/icons-material": "^7.3.11",
        "@mui/material": "^7.3.11",
        "generic-filehandle2": "2.2.0",
        "next": "^15.5.24",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@opennextjs/cloudflare": "^1.20.4",
        "@playwright/test": "^1.54.2",
        "@tailwindcss/postcss": "^4",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^4.4.1",
        "d3-geo": "^3.1.1",
        "eslint": "^9.39.5",
        "eslint-config-next": "^15.5.24",
        "i18n-iso-countries": "^7.14.0",
        "jsdom": "^26.1.0",
        "patch-package": "^8.0.1",
        "tailwindcss": "^4",
        "topojson-client": "^3.1.0",
        "typescript": "^5",
        "vitest": "^3.2.4",
        "world-atlas": "^2.0.2",
        "wrangler": "^4.127.0"
    },
    "overrides": {
        "dompurify": "3.4.14",
        "nanoid": "3.3.18",
        "sharp": "0.35.0",
        "postcss": "8.5.26"
    }
}
