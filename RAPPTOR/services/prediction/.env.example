RAPPTOR_MODEL_VERSION=candidate-github-93cf
RAPPTOR_CGR_CACHE_ROOT=/data/cgr-cache
RAPPTOR_CGR_VERSION=cgr-128-v1
RAPPTOR_MODEL_HOST_DIR=./model-assets/candidate-github-93cf
RAPPTOR_GPU_INDEX=0
RAPPTOR_API_PORT=8000
# Keep this value the same as the web app upload/request limit (default: 12 MiB).
RAPPTOR_MAX_REQUEST_BYTES=12582912
RAPPTOR_MAX_QUEUE_LENGTH=100
RAPPTOR_MIN_SCAN_STRIDE=1
RAPPTOR_MAX_SCAN_STRIDE=1000
RAPPTOR_DEFAULT_SCAN_STRIDE=1
# Full-position prediction artifacts are retained for 24 hours.
RAPPTOR_FILE_RETENTION_SECONDS=86400
# Local-only default. `npm run deployment:ticket` generates the production
# services/prediction/.env from the repository-root .env.deploy file.
RAPPTOR_TICKET_VALIDATION_MODE=disabled
# Production requires mode=cloudflare, both Worker callback URLs, and the same
# secret value in RAPPTOR_TICKET_SERVICE_SECRET/RAPPTOR_JOB_CALLBACK_SECRET.
# The Worker stores that shared value as RAPPTOR_PREDICTION_SERVICE_SECRET.
