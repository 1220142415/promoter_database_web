# Optional production object-storage root. Leave unset for local development;
# the app will use /api/local-data and the generated .data release directory.
# Hugging Face Dataset pilot example:
# NEXT_PUBLIC_STORAGE_BASE_URL=https://huggingface.co/datasets/<owner>/<repo>/resolve/main/releases/2026-08-07/objects

# Optional production root for release.json, manifest.tsv and checksums.sha256.
# NEXT_PUBLIC_RELEASE_ASSET_BASE_URL=https://huggingface.co/datasets/<owner>/<repo>/resolve/main/releases/2026-08-07

# Used only by the local Hugging Face upload/verification scripts. Keep HF_TOKEN
# in your shell or Hugging Face credential store; never save it in this file.
# HF_REPO_ID=<owner>/<repo>

# Optional phase-two pilot: load public files for only these accessions directly
# from the verified remote Dataset while all other genomes use LOCAL_DATA_ROOT.
# HF_PILOT_STORAGE_BASE_URL=https://huggingface.co/datasets/<owner>/<repo>/resolve/main/releases/2026-08-07/objects
# HF_PILOT_ACCESSIONS=GCA_000411415.1,GCA_000421325.1

# Packed Hugging Face release mode. D1 supplies the active release repository,
# pack path, byte offsets, and logical asset lengths.
# NEXT_PUBLIC_STORAGE_BASE_URL=/api/remote-data
# NEXT_PUBLIC_RELEASE_ASSET_BASE_URL=https://huggingface.co/datasets/liurulong/bacterial-promoter-genomes/resolve/main/releases/2026-08-11
# HF_STORAGE_BASE_URL=https://huggingface.co/datasets/liurulong/bacterial-promoter-genomes/resolve/main
# SEQEDGE_CATALOG_BACKEND=d1

# Optional compatible server endpoint for current-region FASTA/GFF3 exports.
# Local development defaults to /api/local-region. Object storage alone cannot
# create regional exports, so hosted deployments should point this to a service
# implementing /<accession>?ref=...&start=...&end=...&tracks=...&format=....
# NEXT_PUBLIC_REGION_EXPORT_BASE_URL=https://downloads.example.org/region

# Optional local override. The default is:
# <project>/.data/releases/2026-08-07/objects
# LOCAL_DATA_ROOT=D:\\path\\to\\SeqEdge\\.data\\releases\\2026-08-07\\objects
# LOCAL_RELEASE_ROOT=D:\\path\\to\\SeqEdge\\.data\\releases\\2026-08-07

# Separate experimental-TSS collection. Local preview reads its versioned
# catalog directly; production normally reads the independent active release
# from D1. The storage base must point at the same Hugging Face release root as
# catalog.json and is used only for catalog-allowlisted assets.
# EXPERIMENTAL_TSS_CATALOG_PATH=D:\\experimental-tss\\2026-08-25\\catalog.json
# EXPERIMENTAL_TSS_STORAGE_BASE_URL=https://huggingface.co/datasets/<owner>/<repo>/resolve/<revision>/releases/2026-08-25

# Optional, audited reciprocal GCA/GCF pairs whose contig dictionaries and
# reference checksums match. Never populate this from organism names or numeric
# accession stems. Keep the JSON server-side; it is not exposed to the browser.
# UNIFIED_GENOME_ALIASES_JSON=[{"canonicalAccession":"GCA_000000001.1","predictionAccession":"GCA_000000001.1","experimentalAccession":"GCF_000000001.1","relation":"ncbi_reciprocal"}]

# Optional whole-release archive link shown on the Data & Methods page.
# NEXT_PUBLIC_RELEASE_ARCHIVE_URL=https://example.org/gtdb_selected_data_20260807.tar.gz

# Optional temporary HTTP Basic authentication for short-lived demos. Set both
# values only in the process that serves the demo; never commit real credentials.
# SEQEDGE_DEMO_USERNAME=teacher
# SEQEDGE_DEMO_PASSWORD=use-a-random-temporary-password

# Usage analytics are disabled by default. Set this explicitly to on after the
# SEQEDGE_DB D1 binding and migrations/0005_usage_analytics.sql are ready. No IP
# address or user agent is stored: a request becomes a country and a visitor
# token made with a random daily salt stored temporarily in D1.
# SEQEDGE_ANALYTICS=on

# The dashboard at /admin/usage and the export at /api/admin/usage answer 404
# until both values are set, and use HTTP Basic authentication afterwards.
# Set them as Worker secrets in production, never in a committed file.
# SEQEDGE_ANALYTICS_USERNAME=curator
# SEQEDGE_ANALYTICS_PASSWORD=use-a-random-password

# Country-only collection is the default. City, region and coordinates require
# an explicit opt-in.
# SEQEDGE_ANALYTICS_PRECISION=city

# Optional: days of history to keep. Expired rows are removed on the next
# successful counted request or dashboard read.
# SEQEDGE_ANALYTICS_RETENTION_DAYS=400

# Non-Cloudflare deployments may explicitly trust IP and location headers added
# by a controlled reverse proxy. Never enable this for direct, untrusted traffic.
# SEQEDGE_ANALYTICS_TRUST_PROXY_HEADERS=on
